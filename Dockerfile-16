# Debian Bullseye with Python 3.10 in /usr/local (avoids bullseye default Python 3.9)
FROM python:3.10-slim-bullseye

SHELL ["/bin/bash", "-xo", "pipefail", "-c"]   
 
# Generate locale C.UTF-8 for postgres and general locale data  
ENV LANG=C.UTF-8
USER root

# Retrieve the target architecture
ARG TARGETARCH
RUN echo "deb http://ftp.us.debian.org/debian bullseye main" | tee -a /etc/apt/sources.list
RUN apt-get update && \
    apt-get upgrade -y
 
RUN apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
        libxml2-dev \
        libxslt1-dev \
        libldap2-dev \
        libsasl2-dev \
        libssl-dev \
        fonts-noto-cjk \
        git \
        gnupg \
        node-less \
        ca-certificates \
        curl \
        dirmngr \
        npm \
        python3-magic \
        python3-num2words \
        python3-odf \
        python3-pdfminer \
        python3-phonenumbers \
        python3-pyldap \
        python3-qrcode \
        python3-renderpm \
        python3-setuptools \
        python3-slugify \
        python3-vobject \
        python3-watchdog \
        python3-xlrd \
        python3-xlwt \
        nginx \
        supervisor \
        xz-utils \
        libcups2-dev \
        odbc-postgresql \
        redis-server \
        unixodbc-dev \
        awscli \
        cups \
        wget \
        libevent-dev \
        libuv1-dev \
        cython3 \
        nano && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*
    
RUN apt-get update && apt-get install -y --no-install-recommends \
        ghostscript \
        fonts-liberation \
        fonts-dejavu \
        icc-profiles-free \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*


RUN ln -sf /usr/local/bin/pip3 /usr/bin/pip3 && \
    ln -sf /usr/local/bin/pip /usr/bin/pip

# Install wkhtmltopdf with multi-architecture support
RUN apt-get update && apt-get install -y --no-install-recommends \
        apache2-utils \
        xfonts-75dpi \
        xfonts-base \
        ca-certificates \
        curl && \
    if [ "$TARGETARCH" = "amd64" ]; then \
        curl -o wkhtmltox.deb -sSL https://github.com/wkhtmltopdf/packaging/releases/download/0.12.6-1/wkhtmltox_0.12.6-1.buster_amd64.deb && \
        dpkg -i wkhtmltox.deb || apt-get install -f -y && \
        rm -f wkhtmltox.deb; \
    elif [ "$TARGETARCH" = "arm64" ]; then \
        wget https://github.com/wkhtmltopdf/packaging/releases/download/0.12.6-1/wkhtmltox_0.12.6-1.buster_arm64.deb  && apt install -y ./wkhtmltox_0.12.6-1.buster_arm64.deb && \
        rm ./wkhtmltox_0.12.6-1.buster_arm64.deb; \
    fi && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Verify installation (skip for ARM64 to prevent build failures)
RUN if [ "$TARGETARCH" = "amd64" ]; then wkhtmltopdf --version; fi

 
RUN apt-get clean && rm -rf /var/lib/apt/lists/*
  
 
# Build and replace kwkhtmltopdf client
 
# Install latest postgresql-client
RUN echo 'deb http://apt.postgresql.org/pub/repos/apt/ bullseye-pgdg main' > /etc/apt/sources.list.d/pgdg.list \
    && GNUPGHOME="$(mktemp -d)" \
    && export GNUPGHOME \
    && repokey='B97B0AFCAA1A47F044F244A07FCC7D46ACCC4CF8' \
    && gpg --batch --keyserver keyserver.ubuntu.com --recv-keys "${repokey}" \
    && gpg --batch --armor --export "${repokey}" > /etc/apt/trusted.gpg.d/pgdg.gpg.asc \
    && gpgconf --kill all \
    && rm -rf "$GNUPGHOME" \
    && apt-get update \
    && apt-get install --no-install-recommends -y postgresql-client \
    && rm -f /etc/apt/sources.list.d/pgdg.list \
    && rm -rf /var/lib/apt/lists/*

# Install rtlcss
RUN npm install -g rtlcss

# Install Odoo from private GitHub repository
ENV ODOO_VERSION=16.0
ENV DB_NAME=postgres
ENV ODOO_BASE_URL=http://localhost:8069
ENV ODOO_REPORT_URL=http://localhost:8069
# Create odoo user and set up directories
# Create odoo user first (without home directory yet)
# Create odoo user and directory structure
RUN useradd -r -s /bin/bash -U -d /opt/odoo odoo && \
    mkdir -p /opt/odoo && \
    chown odoo:odoo /opt/odoo

# Clone Odoo repository with proper cleanup
RUN rm -rf /opt/odoo 
COPY . /opt/odoo &&  chown -R odoo:odoo /opt/odoo 
 

# Install Python deps: gevent==21.8.0 from Odoo requirements does not build on Py3.10 with current Cython;
# preinstall gevent/greenlet with wheels, then drop those lines (same idea as the former ARM64-only path).
RUN pip3 install --upgrade pip setuptools wheel && \
    if [ "$TARGETARCH" = "arm64" ]; then \
        pip3 install --prefer-binary \
            --extra-index-url=https://www.piwheels.org/simple \
            psycopg2-binary \
            "gevent>=22.10.2" "greenlet>=2.0.0"; \
    else \
        pip3 install --prefer-binary "gevent>=22.10.2" "greenlet>=2.0.0"; \
    fi && \
    sed '/^[[:space:]]*gevent/d;/^[[:space:]]*greenlet/d' /opt/odoo/requirements.txt | pip3 install --no-cache-dir -r /dev/stdin && \
    rm -rf /root/.cache/pip
    


# Copy configuration files
COPY ./entrypoint.sh /
COPY ./odoo.conf /etc/odoo/
COPY ./requirements/16/requirements.txt /mnt/requirements.txt

RUN pip3 install -U -r /mnt/requirements.txt

# Set the default config file
ENV ODOO_RC=/etc/odoo/odoo.conf
COPY ./wait-for-psql.py /usr/local/bin/wait-for-psql.py
COPY ./supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Create necessary directories with proper permissions
RUN mkdir -p /var/lib/odoo && \
    chown odoo:odoo /var/lib/odoo && \
    chmod 777 /var/lib/odoo

# Later in your Dockerfile where you need 777 permissions (if absolutely required)
RUN mkdir -p /var/lib/odoo/filestore && \
    chown odoo:odoo /var/lib/odoo/filestore && \
    chmod 777 /var/lib/odoo/filestore

 

RUN pip install  git+https://github.com/OCA/openupgradelib.git@master

# Install Go for kwkhtmltopdf wrapper
RUN if [ -z "${TARGETARCH}" ]; then \
        TARGETARCH="$(dpkg --print-architecture)"; \
    fi; \
    case ${TARGETARCH} in \
        "amd64") wget https://go.dev/dl/go1.23.4.linux-amd64.tar.gz && tar -C /usr/local -xzf go1.23.4.linux-amd64.tar.gz ;; \
        "arm64") wget https://go.dev/dl/go1.23.4.linux-arm64.tar.gz && tar -C /usr/local -xzf go1.23.4.linux-arm64.tar.gz ;; \
    esac && \
    rm -f go1.23.4.linux-*.tar.gz

# Set up kwkhtmltopdf wrapper
RUN mv /usr/local/bin/wkhtmltopdf /usr/local/bin/wkhtmltopdf_local
ENV WKHTMLTOPDF_PATH=/usr/local/bin/wkhtmltopdf_local
ENV GOPATH=/root/go
ENV PATH=$PATH:/root/go/bin:/usr/local/go/bin

# Build and replace kwkhtmltopdf client
COPY ./kwkhtmltopdf_client.go /tmp/
RUN go build -o /usr/local/bin/wkhtmltopdf /tmp/kwkhtmltopdf_client.go && \
    chmod +x /usr/local/bin/wkhtmltopdf

# Set permissions
RUN chown odoo /etc/odoo/odoo.conf && \
    mkdir -p /mnt/extra-addons && \
    chown -R odoo /mnt/extra-addons && \
    mkdir -p /var/lib/odoo/filestore && \
    chown odoo:odoo /var/lib/odoo/filestore
RUN ln -s /opt/odoo/odoo-bin /usr/bin/odoo && \
    chmod +x /usr/bin/odoo
 
RUN pip3 install --upgrade --force-reinstall greenlet>=2.0.0
RUN  mkdir -p /daysum-cli   
RUN pip3 install -e /opt/odoo  # This makes 'odoo' available globally
RUN pip3 uninstall gevent greenlet -y
RUN pip3  install "gevent==21.12.0" "greenlet==1.1.2"
RUN pip3 install --no-cache-dir "setuptools>=65,<81" && \
    python3 -c "import pkg_resources"
    
RUN if [ -n "$AUTH_USERNAME" ] && [ -n "$AUTH_PASSWORD" ]; then \
        mkdir -p /etc/nginx && \
        echo "$AUTH_PASSWORD" | htpasswd -ci /etc/nginx/.htpasswd "$AUTH_USERNAME" && \
        chmod 644 /etc/nginx/.htpasswd; \
    fi
    
EXPOSE 8080 8069 8072

USER odoo
ENTRYPOINT ["/bin/bash", "-c", "supervisord -c /etc/supervisor/conf.d/supervisord.conf"]
